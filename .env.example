# ============================================================================
#  CSDUV3 - Plantilla de configuración de entorno
# ----------------------------------------------------------------------------
#  Copie este archivo como ".env" y reemplace los valores marcados (TU_...).
#  El archivo ".env" NUNCA debe subirse al repositorio ni a un directorio
#  accesible desde el navegador.
# ============================================================================

# --- Aplicación ---
APP_NAME="Club Social Deportivo Unidad Vecinal N.º 3"
APP_SHORT_NAME="CSDUV3"
# Los valores por defecto corresponden a PRODUCCIÓN. Para trabajar en local,
# cambie APP_ENV a "development" y APP_DEBUG a "true"; en producción déjelos como
# están, porque el detalle técnico de los errores quedaría visible para cualquiera.
APP_ENV=production
APP_DEBUG=false
# URL base del sitio. Reemplace "TU_SUBDOMINIO" por el dominio real
# (por ejemplo, https://midominio.ejemplo.com). Si se deja vacío, la aplicación
# genera rutas relativas y funciona con cualquier host.
APP_URL="https://TU_SUBDOMINIO"
APP_TIMEZONE=America/Lima
APP_LOCALE=es_PE

# --- Base de datos (MariaDB / MySQL) ---
# Reemplace los marcadores por los datos reales que figuran en cPanel. Si el
# panel usa un prefijo de cuenta, el nombre completo suele tener la forma
# TU_CUENTA_nombredelabase: ese nombre es el que debe escribirse aquí.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=TU_BASE_DE_DATOS
DB_USERNAME=TU_USUARIO_BD
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE_OFFSET=-05:00

# --- Sesiones ---
SESSION_NAME=csduv3_sesion
SESSION_LIFETIME=7200
# true cuando el sitio se sirve por HTTPS (valor de producción).
# Ponga false solo si va a acceder por HTTP sin cifrar en un entorno local.
SESSION_SECURE=true

# --- Seguridad ---
# Cadena aleatoria larga y única por instalación (mínimo 32 caracteres).
APP_KEY=
# Intentos fallidos permitidos antes de bloquear temporalmente el acceso.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Archivos subidos ---
UPLOAD_MAX_SIZE_MB=5

# --- Registro de eventos ---
# Niveles: debug | info | warning | error | critical
# "warning" es el valor de producción; use "debug" solo en desarrollo.
LOG_LEVEL=warning
